# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Find the values in Supabase: Project Settings > API (or API Keys).

# --- Website: bundled into the browser, so public values only ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Scripts and server code only. Never prefix these with VITE_ ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or the legacy "service_role" key. It bypasses every access rule.
SUPABASE_SECRET_KEY=
